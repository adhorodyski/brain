# Copy to .dev.vars for `npm run dev`. On the deployed worker these are secrets,
# except the two MODEL_* settings you can keep as plain text.

# Any OpenAI-compatible chat endpoint. MODEL_ID goes on the wire unchanged.
MODEL_BASE_URL=https://your-provider.example/v1
MODEL_ID=your-model-name
MODEL_API_KEY=sk-your-key

# Optional, and only needed if the endpoint disagrees with these defaults:
# MODEL_CONTEXT_WINDOW=128000
# MODEL_MAX_TOKENS=8192
# MODEL_REASONING=true

TELEGRAM_BOT_TOKEN=123456:ABC-def
TELEGRAM_WEBHOOK_SECRET=replace-with-openssl-rand-hex-24
TELEGRAM_CHAT_ID=123456789
BRAIN_TOKEN=replace-with-openssl-rand-hex-32

# Optional: a token that sees `recall` alone. Unset means no read-only access.
# BRAIN_READ_ONLY_TOKEN=

# Optional: only needed once you serve a custom hostname.
# BRAIN_HOSTNAME=brain.example.com
